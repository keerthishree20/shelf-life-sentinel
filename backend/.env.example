# Copy to .env and fill in.

# SQLite by default. The path is relative to the directory uvicorn runs from,
# so launch the backend from backend/ (see README) or use an absolute path.
DATABASE_URL=sqlite+aiosqlite:///./shelflife.db

# How many days ahead counts as "expiring soon" on the dashboard and alerts.
EXPIRY_WARNING_DAYS=7

# Optional. Without it the scanner falls back to Tesseract OCR, which works but
# reads difficult packaging less reliably. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
